<Window x:Class="Vitakora.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vitakora" Width="980" Height="680" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen" Background="{StaticResource Background}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#202123" Padding="18"><StackPanel>
<TextBlock Text="Vitakora" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20"/>
<TextBlock x:Name="ServerStatusText" Text="Buscando servidor Vitakora en la red…" Foreground="#D9D9E3" TextWrapping="Wrap" Margin="0,0,0,8"/>
<Button x:Name="SearchButton" Content="Buscar de nuevo" Height="32" Margin="0,0,0,22" Click="Search_Click"/>
<TextBlock Text="Usuario" Foreground="#B8B8BD"/><TextBox x:Name="UsernameBox" Margin="0,6,0,12" Height="34"/>
<TextBlock Text="Contraseña" Foreground="#B8B8BD"/><PasswordBox x:Name="PasswordBox" Margin="0,6,0,12" Height="34"/>
<TextBlock Text="Puesto" Foreground="#B8B8BD"/><ComboBox x:Name="WorkstationBox" DisplayMemberPath="Name" Margin="0,6,0,12" Height="34"/>
<Button x:Name="LoginButton" Content="Entrar" Height="38" IsEnabled="False" Click="Login_Click"/>
<TextBlock x:Name="StatusText" Foreground="#D9D9E3" TextWrapping="Wrap" Margin="0,16,0,0"/>
</StackPanel></Border>
<Grid Grid.Column="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,14"><TextBlock Text="Chat" FontSize="24" FontWeight="SemiBold"/><ComboBox x:Name="PresenceBox" Width="160" HorizontalAlignment="Right" DockPanel.Dock="Right" SelectionChanged="PresenceBox_SelectionChanged"/></DockPanel>
<ListBox x:Name="MessagesList" Grid.Row="1" BorderThickness="0" Background="Transparent"/>
<Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
<ComboBox x:Name="RecipientBox" DisplayMemberPath="Name"/><TextBox x:Name="MessageBox" Grid.Column="1" Margin="8,0" Height="42" VerticalContentAlignment="Center"/><Button Grid.Column="2" Content="Enviar" Click="Send_Click"/>
</Grid></Grid></Grid></Window>
